generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  user
  creator
  seller
  moderator
  admin
}

enum UserStatus {
  active
  suspended
  banned
  pending_verification
}

enum TransactionType {
  coin_purchase
  gift_sent
  gift_received
  marketplace_purchase
  marketplace_sale
  withdrawal
  tournament_entry
  tournament_prize
  refund
}

enum TransactionStatus {
  pending
  completed
  failed
  reversed
}

enum ListingCategory {
  services
  digital_items
  gaming_accounts
  gaming_coaching
  gaming_items
  other
}

enum ListingStatus {
  draft
  active
  sold
  removed
}

enum OrderStatus {
  pending
  in_progress
  delivered
  completed
  disputed
  cancelled
  refunded
}

enum TournamentStatus {
  upcoming
  open
  in_progress
  completed
  cancelled
}

enum TournamentFormat {
  single_elimination
  double_elimination
  round_robin
}

enum StreamStatus {
  idle
  live
  ended
}

enum PostStatus {
  processing
  active
  removed
  flagged
}

enum NotificationType {
  like
  comment
  follow
  mention
  gift
  stream_live
  dm
  system
  tournament
}

enum ReportReason {
  spam
  harassment
  hate_speech
  nudity
  violence
  misinformation
  copyright
  other
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  phone               String?    @unique
  username            String     @unique
  displayName         String
  passwordHash        String
  role                UserRole   @default(user)
  status              UserStatus @default(pending_verification)
  isEmailVerified     Boolean    @default(false)
  isPhoneVerified     Boolean    @default(false)
  isCreator           Boolean    @default(false)
  isSeller            Boolean    @default(false)
  avatarUrl           String?
  bannerUrl           String?
  bio                 String?    @db.Text
  website             String?
  location            String?
  followersCount      Int        @default(0)
  followingCount      Int        @default(0)
  postsCount          Int        @default(0)
  lastActiveAt        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  profile             GamingProfile?
  wallet              Wallet?
  stripeConnectId     String?
  notifications       NotificationPreference?
  sentFollows         Follow[]              @relation("follower")
  receivedFollows     Follow[]              @relation("following")
  blockedUsers        Block[]               @relation("blocker")
  blockedByUsers      Block[]               @relation("blocked")
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  saves               Save[]
  streams             Stream[]
  orders              Order[]               @relation("buyer")
  sales               Order[]               @relation("seller")
  listings            Listing[]
  reports             Report[]              @relation("reporter")
  reportedContent     Report[]              @relation("reportedUser")
  adminActions        ModerationLog[]
  clanMemberships     ClanMember[]
  tournamentEntries   TournamentEntry[]

  @@index([username])
  @@index([email])
  @@index([status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// ─────────────────────────────────────────────
// POSTS & MEDIA
// ─────────────────────────────────────────────

model Post {
  id            String     @id @default(cuid())
  authorId      String
  caption       String?    @db.Text
  status        PostStatus @default(processing)
  likesCount    Int        @default(0)
  commentsCount Int        @default(0)
  sharesCount   Int        @default(0)
  savesCount    Int        @default(0)
  viewsCount    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media         MediaAsset[]
  hashtags      PostHashtag[]
  comments      Comment[]
  likes         Like[]
  saves         Save[]
  @@index([authorId])
  @@index([status, createdAt])
}

model MediaAsset {
  id           String    @id @default(cuid())
  postId       String
  s3Key        String
  url          String
  thumbnailUrl String?
  type         String    // 'image' | 'video'
  mimeType     String
  width        Int?
  height       Int?
  duration     Float?
  sizeBytes    Int
  order        Int       @default(0)
  createdAt    DateTime  @default(now())

  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Hashtag {
  id        String   @id @default(cuid())
  name      String   @unique
  postsCount Int     @default(0)
  createdAt DateTime @default(now())

  posts     PostHashtag[]

  @@index([name])
}

model PostHashtag {
  postId    String
  hashtagId String

  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
}

model Comment {
  id           String   @id @default(cuid())
  postId       String
  authorId     String
  parentId     String?
  body         String   @db.Text
  likesCount   Int      @default(0)
  repliesCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent       Comment? @relation("replies", fields: [parentId], references: [id])
  replies      Comment[] @relation("replies")

  @@index([postId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// WALLET & TRANSACTIONS
// ─────────────────────────────────────────────

model Wallet {
  id                    String        @id @default(cuid())
  userId                String        @unique
  coinBalance           Int           @default(0)
  earningsBalanceUsdCents Int         @default(0)
  lifetimeEarningsUsdCents Int        @default(0)
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
}

model Transaction {
  id              String            @id @default(cuid())
  walletId        String
  type            TransactionType
  status          TransactionStatus @default(pending)
  coinAmount      Int?
  usdCents        Int?
  description     String
  referenceId     String?
  idempotencyKey  String?           @unique
  stripePaymentId String?
  createdAt       DateTime          @default(now())

  wallet          Wallet            @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([stripePaymentId])
}

model CoinPackage {
  id          String   @id @default(cuid())
  coins       Int
  bonusCoins  Int      @default(0)
  priceUsdCents Int
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// LIVESTREAMS
// ─────────────────────────────────────────────

model Stream {
  id                String       @id @default(cuid())
  hostId            String
  title             String
  description       String?      @db.Text
  thumbnailUrl      String?
  category          String
  tags              String[]
  status            StreamStatus @default(idle)
  agoraChannelId    String       @unique @default(cuid())
  viewerCount       Int          @default(0)
  peakViewerCount   Int          @default(0)
  totalGiftsCoins   Int          @default(0)
  recordingUrl      String?
  recordingS3Key    String?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime     @default(now())

  host              User         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  gifts             StreamGift[]

  @@index([hostId])
  @@index([status, createdAt])
  @@index([category])
}

model Gift {
  id             String   @id @default(cuid())
  name           String
  animationUrl   String
  iconUrl        String
  coinValue      Int
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  streamGifts    StreamGift[]
}

model StreamGift {
  id          String   @id @default(cuid())
  streamId    String
  senderId    String
  giftId      String
  quantity    Int      @default(1)
  coinValue   Int
  createdAt   DateTime @default(now())

  stream      Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  gift        Gift     @relation(fields: [giftId], references: [id])

  @@index([streamId, createdAt])
  @@index([senderId])
}

// ─────────────────────────────────────────────
// MARKETPLACE
// ─────────────────────────────────────────────

model Listing {
  id              String          @id @default(cuid())
  sellerId        String
  title           String
  description     String          @db.Text
  category        ListingCategory
  priceUsdCents   Int?
  priceCoins      Int?
  images          String[]
  status          ListingStatus   @default(draft)
  averageRating   Float           @default(0)
  totalSales      Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  seller          User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders          Order[]
  reviews         Review[]

  @@index([sellerId])
  @@index([category, status])
}

model Order {
  id          String      @id @default(cuid())
  listingId   String
  buyerId     String
  sellerId    String
  status      OrderStatus @default(pending)
  priceUsdCents Int?
  priceCoins  Int?
  buyerNote   String?     @db.Text
  deliveryNote String?    @db.Text
  stripePaymentIntentId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  listing     Listing     @relation(fields: [listingId], references: [id])
  buyer       User        @relation("buyer", fields: [buyerId], references: [id])
  seller      User        @relation("seller", fields: [sellerId], references: [id])
  review      Review?
  dispute     Dispute?

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  listingId   String
  reviewerId  String
  rating      Int
  body        String?  @db.Text
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])
  listing     Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

model Dispute {
  id          String   @id @default(cuid())
  orderId     String   @unique
  reason      String   @db.Text
  resolution  String?  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])
}

// ─────────────────────────────────────────────
// GAMING
// ─────────────────────────────────────────────

model GamingProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  favoriteGames   String[]
  totalXp         Int      @default(0)
  level           Int      @default(1)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastStreakDate  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges          UserBadge[]
  xpEvents        XpEvent[]
  missionProgress DailyMissionProgress[]
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  iconUrl     String
  xpRequired  Int?
  isAutomatic Boolean     @default(true)

  userBadges  UserBadge[]
}

model UserBadge {
  gamingProfileId String
  badgeId         String
  earnedAt        DateTime @default(now())

  gamingProfile   GamingProfile @relation(fields: [gamingProfileId], references: [id], onDelete: Cascade)
  badge           Badge         @relation(fields: [badgeId], references: [id])

  @@id([gamingProfileId, badgeId])
}

model XpEvent {
  id              String   @id @default(cuid())
  gamingProfileId String
  amount          Int
  reason          String
  referenceId     String?
  createdAt       DateTime @default(now())

  gamingProfile   GamingProfile @relation(fields: [gamingProfileId], references: [id], onDelete: Cascade)

  @@index([gamingProfileId, createdAt])
}

model DailyMission {
  id          String   @id @default(cuid())
  title       String
  description String
  xpReward    Int
  target      Int
  action      String
  isActive    Boolean  @default(true)

  progress    DailyMissionProgress[]
}

model DailyMissionProgress {
  id              String   @id @default(cuid())
  gamingProfileId String
  missionId       String
  date            String   // YYYY-MM-DD
  current         Int      @default(0)
  completed       Boolean  @default(false)
  completedAt     DateTime?

  gamingProfile   GamingProfile @relation(fields: [gamingProfileId], references: [id], onDelete: Cascade)
  mission         DailyMission  @relation(fields: [missionId], references: [id])

  @@unique([gamingProfileId, missionId, date])
}

model Clan {
  id          String   @id @default(cuid())
  name        String   @unique
  tag         String   @unique @db.VarChar(8)
  description String?  @db.Text
  logoUrl     String?
  bannerUrl   String?
  ownerId     String
  isPublic    Boolean  @default(true)
  memberCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ClanMember[]
  tournaments Tournament[]

  @@index([name])
}

model ClanMember {
  clanId    String
  userId    String
  role      String   @default("member") // owner | admin | member
  joinedAt  DateTime @default(now())

  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clanId, userId])
  @@index([userId])
}

model Tournament {
  id                   String           @id @default(cuid())
  title                String
  game                 String
  format               TournamentFormat
  status               TournamentStatus @default(upcoming)
  entryFeeCoins        Int              @default(0)
  prizePoolCoins       Int              @default(0)
  maxParticipants      Int
  currentParticipants  Int              @default(0)
  clanId               String?
  startsAt             DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  clan                 Clan?            @relation(fields: [clanId], references: [id])
  entries              TournamentEntry[]

  @@index([status, startsAt])
  @@index([game])
}

model TournamentEntry {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  placement    Int?
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  imageUrl    String?
  referenceId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model NotificationPreference {
  id            String  @id @default(cuid())
  userId        String  @unique
  likes         Boolean @default(true)
  comments      Boolean @default(true)
  follows       Boolean @default(true)
  mentions      Boolean @default(true)
  gifts         Boolean @default(true)
  streamLive    Boolean @default(true)
  dms           Boolean @default(true)
  system        Boolean @default(true)

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// MODERATION & REPORTS
// ─────────────────────────────────────────────

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  targetType     String       // 'post' | 'comment' | 'stream' | 'user' | 'listing'
  targetId       String
  reason         ReportReason
  description    String?      @db.Text
  isResolved     Boolean      @default(false)
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  reporter       User         @relation("reporter", fields: [reporterId], references: [id])
  reportedUser   User?        @relation("reportedUser", fields: [reportedUserId], references: [id])

  @@index([targetType, targetId])
  @@index([isResolved, createdAt])
}

model ModerationLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String
  targetId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
