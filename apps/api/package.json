    "@typescript-eslint/parser": "^7.15.0",
    "@vesioh/config": "*",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prisma": "^5.16.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
